# Copy to configs/cluster.local.env and fill in your private machine settings.
# Use literal values; quote values containing spaces. This file is an example.
PASSGAME_SSH_HOST=YOUR_SSH_ALIAS
PASSGAME_REMOTE_ROOT=/path/to/cluster/workspace/passgame
PASSGAME_ACCOUNT=YOUR_ACCOUNT
PASSGAME_PARTITION=YOUR_GPU_PARTITION
PASSGAME_GPU_RESOURCE=gpu:a100:1
PASSGAME_SIF=/path/to/vllm-container.sif
PASSGAME_MODEL_DIR=/path/to/model-weights
PASSGAME_MODEL_REVISION=YOUR_WEIGHT_REVISION
PASSGAME_MODEL_PROVENANCE=''
# Optional: PASSGAME_SSH_SOCKET=/path/to/private/control-socket
