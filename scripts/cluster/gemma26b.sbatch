#!/bin/bash
# Submit from the frozen snapshot root, supplying account and partition
# privately to sbatch. The runtime environment is generated by package_cluster.py.
# The 26B BF16 weights span two GPUs on one node.
#SBATCH --job-name=passgame-gemma26b
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:a100:2
#SBATCH --cpus-per-task=8
#SBATCH --mem=96G
#SBATCH --time=00:30:00
set -euo pipefail
: "${SLURM_SUBMIT_DIR:?Submit this script from the frozen snapshot root}"
export VLLM_EXTRA_ARGS="--tensor-parallel-size 2"
exec bash "$SLURM_SUBMIT_DIR/scripts/cluster/run_evaluation.sh"
